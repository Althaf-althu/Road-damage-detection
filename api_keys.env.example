# ==============================================================================
# CENTRAL EXTERNAL API KEYS & CREDENTIALS TEMPLATE
# Kerala Road Damage Detection System
# ==============================================================================
# Instructions:
# 1. Copy this file to api_keys.env:
#    cp api_keys.env.example api_keys.env
# 2. Open the signup/dashboard URL provided above each key.
# 3. Generate or copy your API key and paste after the '=' sign.
# ==============================================================================

# ------------------------------------------------------------------------------
# REGION CONFIGURATION (Multi-State Support)
# To switch to another state: change REGION_NAME and REGION_OSM_RELATION_ID
# ------------------------------------------------------------------------------
REGION_NAME=kerala
REGION_DISPLAY_NAME=Kerala
REGION_AUTHORITY=Kerala Public Works Department
REGION_AUTHORITY_SHORT=Kerala PWD
# OSM Relation ID for the state boundary (Kerala = 1263070)
# Other states: Maharashtra=1950884, Tamil Nadu=184640, Karnataka=1272161
REGION_OSM_RELATION_ID=1263070
# Bounding box fallback: min_lat,min_lon,max_lat,max_lon
REGION_BBOX=8.17,74.85,12.78,77.42

# ------------------------------------------------------------------------------
# 1. GEOTECHNICAL AI ADVISOR ENGINE
# ------------------------------------------------------------------------------
# Choose provider: gemini | openai | anthropic
LLM_PROVIDER=gemini

# Google Gemini API Key (Free tier: 1M tokens/month on gemini-1.5-flash)
# Get key here: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional alternative)
# Get key here: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API Key (Optional alternative)
# Get key here: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here


# ------------------------------------------------------------------------------
# 2. MAP TILES (Free - No key required by default)
# ------------------------------------------------------------------------------
# CARTO Basemaps API Key (Get key at: https://carto.com/basemaps/apikey)
NEXT_PUBLIC_CARTO_API_KEY=

# Mapbox Public Access Token (Optional)
# Get key here: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# Default: CartoDB Dark Matter tiles are used automatically (100% free, no key)


# ------------------------------------------------------------------------------
# 3. CITIZEN TRANSACTIONAL RESOLUTION EMAILS
# Primary: Gmail SMTP with App Password (Free)
# Generate App Password: https://myaccount.google.com/apppasswords
# (Enable 2FA first, then create a 16-char App Password for "Mail")
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_APP_PASSWORD=your_16_char_google_app_password
EMAIL_FROM_ADDRESS=noreply@keralaroads.gov.in
EMAIL_FROM_NAME=Kerala PWD Road Maintenance

# Alternative: Resend API (Fast, modern, 3000 emails/month free)
# Get key here: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Alternative: SendGrid API Key
# Get key here: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your_sendgrid_api_key_here


# ------------------------------------------------------------------------------
# 4. MEDIA STORAGE
# Default: Local /backend/uploads/ directory (no key needed)
# Optional: Cloudinary for cloud hosting
# ------------------------------------------------------------------------------
# Cloudinary (Optional - Easy image/video hosting)
# Get credentials here: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Supabase Storage (Optional alternative)
# Get credentials here: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Storage backend: local | cloudinary | supabase
STORAGE_BACKEND=local

# ------------------------------------------------------------------------------
# 5. INITIAL ADMIN CONSOLE CREDENTIALS
# ------------------------------------------------------------------------------
# Set your desired administrator login credentials
ADMIN_EMAIL=admin@pwd.kerala.gov.in
ADMIN_NAME=Kerala PWD Administrator
ADMIN_PASSWORD=ChangeMe@2026!


