# Application Environment Variables Template
# Copy this file to .env and fill in values

# Database
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/road_damage_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Secret (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=change_this_to_a_random_secret_key_minimum_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App Settings
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Frontend API base URL (used by Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_CARTO_API_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=

# Spatial Settings (overridable by admin in UI for mis-snap corrections)
DEFAULT_SNAP_RADIUS_M=25
DEFAULT_DEDUP_RADIUS_M=30
RESOLVED_GREEN_DAYS=90

# Admin Console Credentials
ADMIN_EMAIL=admin@pwd.kerala.gov.in
ADMIN_NAME=Kerala PWD Administrator
ADMIN_PASSWORD=ChangeMe@2026!


